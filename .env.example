# Copy this file to .env and adjust values as needed.
# All variables are prefixed with MCP_GATEWAY_.

# --- Application settings ---
MCP_GATEWAY_APP_NAME=mcp-gateway
MCP_GATEWAY_ENVIRONMENT=development
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8000
MCP_GATEWAY_LOG_LEVEL=INFO
MCP_GATEWAY_REQUEST_TIMEOUT_SECONDS=30

# --- Gateway/upstream settings ---
# Complex fields (upstreams, auth, rate_limit) accept JSON-encoded values.
# MCP_GATEWAY_UPSTREAMS=[{"name":"example","url":"http://localhost:9000"}]
# MCP_GATEWAY_AUTH__ENABLED=false
# MCP_GATEWAY_AUTH__PROVIDER=none
# Single-key mode: any caller presenting this key may reach any upstream.
# MCP_GATEWAY_AUTH__API_KEY=change-me
# Multi-client mode: each client has its own key and upstream allowlist.
# Omit "allowed_upstreams" (or set null) to allow that client all upstreams.
# MCP_GATEWAY_AUTH__CLIENTS=[{"client_id":"client-a","api_key":"key-a","allowed_upstreams":["database","github"]}]
# MCP_GATEWAY_RATE_LIMIT__ENABLED=false
# MCP_GATEWAY_RATE_LIMIT__REQUESTS_PER_MINUTE=60
# Optional token-bucket burst capacity; must be >= requests_per_minute.
# MCP_GATEWAY_RATE_LIMIT__BURST=120

# Alternatively, point at a JSON file holding gateway configuration
# (env vars above still take precedence over file values):
# MCP_GATEWAY_CONFIG_FILE=./gateway.config.json
